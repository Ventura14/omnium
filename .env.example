# Copia este archivo a .env.local y rellena los valores reales.
# .env.local esta en .gitignore (patron .env* desde la raiz) -- nunca
# deberia aparecer en un commit. Solo este .example, con valores
# vacios, se versiona.

# Panel de Supabase -> Project Settings -> API.
# NEXT_PUBLIC_SUPABASE_ANON_KEY es la clave publica (anon/publishable),
# segura para el frontend -- RLS es lo que la limita, no el secreto de
# la clave. Nunca pongas aqui la service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Zona horaria de las fechas de dominio (semana, plan, objetivos): nombre
# IANA. Opcional; por defecto Europe/Madrid. Pon la tuya para que "hoy" y
# el lunes de la semana coincidan con tu calendario, no con el del
# servidor (que corre en UTC). Ej.: America/Mexico_City, Europe/London.
# En Vercel: Project Settings -> Environment Variables.
# APP_TIMEZONE=Europe/Madrid
