# Copia este archivo a .env.local y rellena los valores reales.
# .env.local esta en .gitignore (patron .env* desde la raiz) -- nunca
# deberia aparecer en un commit. Solo este .example, con valores
# vacios, se versiona.

# Panel de Supabase -> Project Settings -> API.
# NEXT_PUBLIC_SUPABASE_ANON_KEY es la clave publica (anon/publishable),
# segura para el frontend -- RLS es lo que la limita, no el secreto de
# la clave. Nunca pongas aqui la service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
