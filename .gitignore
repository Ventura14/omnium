# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# datos de scrapers: son de terceros (tiendas), no van al repo.
# dia_sample.json y mercadona_sample.json ya estaban commiteados
# antes de esta regla (sondas de viabilidad, deliberado en su
# momento) -- no se tocan retroactivamente, esto solo evita que se
# repita con salidas nuevas.
services/scrapers/data/*.json

# imagenes originales descargadas de Dia, resolucion completa -- solo
# para poder re-recortar en local sin volver a pedirselas a Dia.
# Las miniaturas redimensionadas para /compra SI van al repo, en
# public/products/ (ver services/scrapers/dia_images.py).
services/scrapers/data/images/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
